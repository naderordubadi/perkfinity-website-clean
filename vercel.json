{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    }
  ],
  "rewrites": [
    { "source": "/store/:slug", "destination": "/api/store-page?slug=:slug" },
    { "source": "/deals/:location", "destination": "/api/deals-page?location=:location" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-live.xml", "destination": "/api/sitemap" },
    { "source": "/join/:code", "destination": "/join/index.html" },
    { "source": "/codes", "destination": "/codes.html" },
    { "source": "/localperks", "destination": "/localperks.html" },
    { "source": "/merchants", "destination": "/merchants.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/enterprise", "destination": "/enterprise.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/terms-of-use", "destination": "/terms-of-use.html" },
    { "source": "/apply", "destination": "/apply.html" },
    { "source": "/get-started", "destination": "/get-started.html" }
  ],
  "redirects": [
    { "source": "/deals/store/:merchant", "destination": "/store/:merchant", "permanent": true },
    { "source": "/deals", "destination": "/localperks", "permanent": true },
    { "source": "/how-it-works", "destination": "/merchants", "permanent": true },
    { "source": "/how-it-works.html", "destination": "/merchants", "permanent": true },
    { "source": "/members", "destination": "/", "permanent": true },
    { "source": "/members.html", "destination": "/", "permanent": true },
    { "source": "/merchants-search", "destination": "/localperks", "permanent": true },
    { "source": "/merchants-search.html", "destination": "/localperks", "permanent": true },
    { "source": "/beta-test", "destination": "/beta-test/part1.html", "permanent": false },
    { "source": "/qr/:code", "destination": "https://app.perkfinity.net/qr/:code", "permanent": false }
  ]
}
